# ── Gemini AI (required) ─────────────────────────────────────────────────────
# Get from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Supabase (optional — enables scan persistence and auth) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Lead notification webhook (optional) ─────────────────────────────────────
# POST a Slack/Discord/Zapier webhook URL to get notified on new email captures
LEAD_NOTIFICATION_URL=
